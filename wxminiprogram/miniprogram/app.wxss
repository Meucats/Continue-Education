page {
  --accent: #1558c7;
  --accent-strong: #11489f;
  --accent-soft: #e9f1fc;
  --accent-line: #c8dbf6;
  --bg: #f3f4f7;
  --surface: #ffffff;
  --surface-2: #f8f9fb;
  --ink: #1b1f27;
  --ink-2: #55606e;
  --ink-3: #6b7482;
  --line: #e4e7ec;
  --line-strong: #d3d8e0;
  --success: #0f7a3d;
  --success-bg: #e8f6ee;
  --warning: #a45a09;
  --warning-bg: #fdf2e3;
  --danger: #c02626;
  --danger-bg: #fdecec;
  --neutral: #5a6472;
  --neutral-bg: #eef1f5;
  --r-card: 24rpx;
  --r-ctrl: 16rpx;
  --shadow-1: 0 2rpx 8rpx rgba(16, 24, 40, 0.05);
  --shadow-2: 0 8rpx 24rpx -6rpx rgba(16, 24, 40, 0.08);

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  font-size: inherit;
  border-radius: 0;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.container {
  padding: 20rpx;
}

/* ===== 按钮 ===== */
.btn-primary {
  background-color: var(--accent);
  color: white;
  border-radius: var(--r-ctrl);
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
  transition: opacity 0.15s ease;
}

.btn-primary[disabled] {
  background-color: #9db8e0;
  color: rgba(255, 255, 255, 0.85);
}

.btn-primary:active {
  background-color: var(--accent-strong);
  opacity: 0.92;
}

.btn-success {
  background-color: var(--success);
  color: white;
  border-radius: var(--r-ctrl);
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-success:active {
  opacity: 0.9;
}

.btn-danger {
  background-color: var(--danger);
  color: white;
  border-radius: var(--r-ctrl);
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-danger:active {
  opacity: 0.9;
}

.btn-secondary {
  background-color: var(--neutral-bg);
  color: var(--ink-2);
  border-radius: var(--r-ctrl);
  font-size: 32rpx;
  font-weight: 550;
  padding: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-secondary:active {
  background-color: var(--line);
}

.btn-small {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 550;
  padding: 0 28rpx;
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ===== 卡片 ===== */
.card {
  background-color: var(--surface);
  border-radius: var(--r-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
}

/* ===== 表单 ===== */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
  font-weight: 550;
}

.input-field {
  border: 2rpx solid var(--line);
  border-radius: var(--r-ctrl);
  padding: 0 24rpx;
  font-size: 30rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  background-color: var(--surface);
  color: var(--ink);
}

.input-field:focus,
.input-field-focus {
  border-color: var(--accent);
  background-color: var(--surface);
}

.textarea-field {
  border: 2rpx solid var(--line);
  border-radius: var(--r-ctrl);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  background-color: var(--surface);
}

/* ===== 标题 ===== */
.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 36rpx;
  letter-spacing: 0.5rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 20rpx;
}

/* ===== 空状态 ===== */
.empty-tip {
  text-align: center;
  color: var(--ink-3);
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* ===== 布局 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ===== 状态标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 999px;
  font-size: 24rpx;
  font-weight: 550;
  color: white;
  line-height: 1.4;
}

.tag-pending {
  background-color: var(--warning);
}

.tag-approved {
  background-color: var(--success);
}

.tag-rejected {
  background-color: var(--danger);
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.info-label {
  font-size: 27rpx;
  color: var(--ink-3);
  min-width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 27rpx;
  color: var(--ink);
  flex: 1;
}

.text-primary {
  color: var(--accent);
}

/* ===== SVG 图标（背景 data-URI，stroke 1.5） ===== */
.ic {
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

