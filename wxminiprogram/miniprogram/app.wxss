/* ===== 共享组件 ===== */
/* 分区卡片 */
.s-card {
  background: var(--surface);
  border-radius: var(--r-card);
  margin: 20rpx 24rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-1);
}

.s-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.s-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.s-title .ic {
  width: 32rpx;
  height: 32rpx;
}

.s-more {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 550;
}

/* 状态徽标（圆角 pill + 语义色底） */
.st-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999px;
  font-size: 26rpx;
  font-weight: 550;
  margin-bottom: 16rpx;
}

.st-badge .ic {
  width: 26rpx;
  height: 26rpx;
}

.st-pending {
  background: var(--warning-bg);
  color: var(--warning);
}

.st-approved {
  background: var(--success-bg);
  color: var(--success);
}

.st-rejected {
  background: var(--danger-bg);
  color: var(--danger);
}

.st-expired {
  background: var(--neutral-bg);
  color: var(--neutral);
}

/* 空状态 */
.e-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.e-box .ic {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}

.e-t {
  font-size: 28rpx;
  font-weight: 550;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}

.e-d {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 提示条 */
.note-bar {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: var(--accent-soft);
  border: 1rpx solid var(--accent-line);
  border-radius: var(--r-ctrl);
  padding: 20rpx 22rpx;
  margin: 20rpx 24rpx;
}

.note-bar .ic {
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
}

.note-txt {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* 信息行（共享） */
.i-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
  gap: 20rpx;
}

.i-row:last-child {
  border-bottom: none;
}

.i-k {
  font-size: 27rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.i-v {
  font-size: 27rpx;
  color: var(--ink);
  font-weight: 550;
  text-align: right;
  word-break: break-all;
}

/* 数字 tabular */
.num {
  font-variant-numeric: tabular-nums;
}

/* ===== 动效 token（taste：cubic-bezier(0.16,1,0.3,1)；常规 150–300ms，焦点 500–800ms；stagger ≤8×60ms） ===== */
:root,
page {
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-fast: 150ms;
  --dur-base: 280ms;
  --dur-slow: 400ms;
}

@keyframes m-fade-up {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes m-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes m-scale-in {
  from { opacity: 0; transform: scale(0.96) translateY(12rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes m-slide-right {
  from { opacity: 0; transform: translateX(-20rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* 页面根入场（tab 页实例常驻，仅首渲染播放） */
.m-page-enter {
  animation: m-fade-up var(--dur-slow) var(--ease-out) both;
}

/* 区块/卡片入场（配合 animation-delay 做 stagger，总延迟封顶 ~480ms） */
.m-enter {
  animation: m-fade-up var(--dur-base) var(--ease-out) both;
}

.m-enter-d1 { animation-delay: 60ms; }
.m-enter-d2 { animation-delay: 120ms; }
.m-enter-d3 { animation-delay: 180ms; }
.m-enter-d4 { animation-delay: 240ms; }
.m-enter-d5 { animation-delay: 300ms; }
.m-enter-d6 { animation-delay: 360ms; }
.m-enter-d7 { animation-delay: 420ms; }
.m-enter-d8 { animation-delay: 480ms; }

/* 列表项 stagger（nth-child 封顶第 8 项，之后无延迟；WXSS 不支持 *，用 view） */
.m-stagger > view {
  animation: m-fade-up var(--dur-base) var(--ease-out) both;
}
.m-stagger > view:nth-child(1) { animation-delay: 40ms; }
.m-stagger > view:nth-child(2) { animation-delay: 80ms; }
.m-stagger > view:nth-child(3) { animation-delay: 120ms; }
.m-stagger > view:nth-child(4) { animation-delay: 160ms; }
.m-stagger > view:nth-child(5) { animation-delay: 200ms; }
.m-stagger > view:nth-child(6) { animation-delay: 240ms; }
.m-stagger > view:nth-child(7) { animation-delay: 280ms; }
.m-stagger > view:nth-child(8) { animation-delay: 320ms; }
.m-stagger > view:nth-child(n+9) { animation-delay: 0ms; animation-duration: 1ms; }

/* 弹层入场 */
.m-modal-enter {
  animation: m-scale-in var(--dur-slow) var(--ease-out) both;
}

.m-mask-enter {
  animation: m-fade-in var(--dur-fast) ease both;
}

/* 按钮/可点反馈（简单 hover/press 走 CSS） */
.m-press {
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) ease, background-color var(--dur-fast) ease;
}
.m-press:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.btn-primary,
.btn-success,
.btn-danger,
.btn-secondary,
.btn-small {
  transition: background-color var(--dur-fast) ease, opacity var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
}

.btn-primary:active,
.btn-success:active,
.btn-danger:active {
  transform: scale(0.98);
}

.card,
.s-card,
.feature-item,
.menu-item,
.action-btn,
.nav-btn,
.tab,
.export-btn,
.floating-btn {
  transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) ease;
}

.floating-btn:active {
  transform: scale(0.94);
}

.tab.active {
  transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
}

/* ===== 小屏 / 安全区 / 触控适配 ===== */
@media (max-width: 320px) {
  .page-title {
    font-size: 32rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .m-page-enter,
  .m-enter,
  .m-stagger > view,
  .m-modal-enter,
  .m-mask-enter {
    animation: none !important;
  }

  .m-press,
  .m-press:active,
  .btn-primary:active,
  .btn-success:active,
  .btn-danger:active,
  .floating-btn:active {
    transform: none !important;
  }
}
