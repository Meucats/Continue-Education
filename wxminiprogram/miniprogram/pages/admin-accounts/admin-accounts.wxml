<view class="accounts-container m-page-enter">
  <view class="page-title">账户管理</view>

  <view class="notice-card card">
    <view class="notice-text">学员以手机号登录，初始密码为身份证后6位（无身份证则手机号后6位），首次登录须修改密码。</view>
  </view>

  <view class="search-box card">
    <input class="search-input" placeholder="搜索学员姓名或手机号" value="{{searchKey}}" bindinput="onSearchInput" bindconfirm="onSearch" />
  </view>

  <view class="stats-bar">
    <text class="stats-text">共 {{filteredAccounts.length}} 个账户</text>
    <view class="export-btn" bindtap="onExport">导出账户信息</view>
  </view>

  <view class="account-list" wx:if="{{filteredAccounts.length > 0}}">
    <view class="account-card card" wx:for="{{filteredAccounts}}" wx:key="_id">
      <view class="account-header">
        <view class="account-name">{{item.name}}</view>
        <view class="account-role {{item.role === 'admin' ? 'admin-role' : 'student-role'}}">
          {{item.role === 'admin' ? '管理员' : '学员'}}
        </view>
      </view>
      <view class="account-info">
        <view class="info-row">
          <text class="info-label">手机号：</text>
          <text class="info-value">{{item.phone}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">创建时间：</text>
          <text class="info-value">{{item.createdAtText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:else>
    <text>暂无账户数据</text>
  </view>
</view>
