.requests-container {
  padding: 20rpx;
  min-height: 100vh;
  background: var(--bg);
}

.requests-container .page-title {
  margin-bottom: 20rpx;
}

.filter-tabs {
  display: flex;
  background-color: var(--surface);
  border-radius: var(--r-ctrl);
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
}

.tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 24rpx 8rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  border-bottom: 3rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  transition: color var(--dur-fast, 150ms) ease, background-color var(--dur-fast, 150ms) ease, border-color var(--dur-fast, 150ms) ease;
}

.tab.active {
  color: var(--accent);
  font-weight: 650;
  border-bottom-color: var(--accent);
  background: var(--accent-soft);
}

.request-card {
  padding: 26rpx;
  margin-bottom: 16rpx;
}

.request-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.request-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.request-info {
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.request-info .info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.request-info .info-label {
  font-size: 25rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.request-info .info-value {
  font-size: 25rpx;
  color: var(--ink);
  text-align: right;
  word-break: break-all;
}

.request-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.request-actions .action-btn {
  flex: 1;
  height: 76rpx !important;
  line-height: 76rpx !important;
  font-size: 28rpx !important;
  padding: 0 !important;
  border-radius: var(--r-ctrl) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-weight: 600 !important;
}

.tag-expired {
  background: var(--neutral-bg);
  color: var(--neutral);
}

.reject-reason {
  color: var(--danger);
}

.request-status-tip {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: var(--r-ctrl);
  font-size: 24rpx;
  font-weight: 550;
  text-align: center;
}

.approved-tip {
  background: var(--success-bg);
  color: var(--success);
}

.expired-tip {
  background: var(--neutral-bg);
  color: var(--neutral);
}

.rejected-tip {
  background: var(--danger-bg);
  color: var(--danger);
}
