.schedule-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.warm-theme {
  --accent: #c2410c;
  --accent-strong: #9a3412;
  --accent-soft: #ffedd5;
  --accent-line: #fed7aa;
}

.calendar-section {
  background: var(--surface);
  padding: 20rpx 24rpx 30rpx;
  border-radius: 0 0 var(--r-card) var(--r-card);
  box-shadow: var(--shadow-1);
}

.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 12rpx 20rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--accent);
  font-weight: 700;
  line-height: 1;
}

.nav-btn:active {
  background: var(--accent-line);
}

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.weekday-header {
  display: flex;
  padding: 10rpx 0;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  font-weight: 550;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.day-number {
  font-size: 28rpx;
  color: var(--ink);
}

.other-month .day-number {
  color: var(--line-strong);
}

.today .day-number {
  color: var(--accent);
  font-weight: 700;
}

.selected {
  background: var(--accent);
  border-radius: 16rpx;
}

.selected .day-number {
  color: #fff !important;
  font-weight: 700;
}

.has-course {
  position: relative;
}

.dot-bar {
  height: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}

.course-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
}

.selected .course-dot {
  background: #fff;
}

.course-section {
  margin: 24rpx;
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 30rpx;
  box-shadow: var(--shadow-1);
}

.schedule-page.m-page-enter .calendar-section {
  animation: m-fade-up var(--dur-base) var(--ease-out) both;
}
.schedule-page.m-page-enter .course-section {
  animation: m-fade-up var(--dur-base) var(--ease-out) both;
  animation-delay: 120ms;
}

.week-course-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.wc-card {
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--line);
}

.wc-card-header {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: var(--surface-2);
  border-bottom: 1rpx solid var(--line);
}

.wc-card-date {
  font-size: 25rpx;
  font-weight: 650;
  color: var(--ink-2);
  flex-shrink: 0;
}

.wc-card-time {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--accent);
  margin-left: 20rpx;
  flex: 1;
}

.wc-card-status {
  font-size: 22rpx;
  font-weight: 550;
  padding: 6rpx 16rpx;
  border-radius: 999px;
  flex-shrink: 0;
}

.st-active {
  background: var(--success-bg);
  color: var(--success);
}

.st-ended {
  background: var(--neutral-bg);
  color: var(--neutral);
}

.wc-card-body {
  background: var(--surface);
  padding: 18rpx 24rpx;
}

.wc-card-class {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.wc-card-loc {
  font-size: 24rpx;
  color: var(--ink-3);
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-ic {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.empty-week {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.prompt-ic {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}

.prompt-text {
  font-size: 27rpx;
  color: var(--ink-2);
  margin-bottom: 24rpx;
}

.prompt-btn {
  width: 60% !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  border-radius: 999px !important;
  font-size: 30rpx !important;
}
