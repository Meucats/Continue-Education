.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  padding: 40rpx;
  box-sizing: border-box;
}

.logo-section {
  text-align: center;
  margin-bottom: 48rpx;
}

.school-logo {
  width: 148rpx;
  height: 148rpx;
  display: block;
  margin: 0 auto 28rpx;
  padding: 14rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 50%;
  border: 3rpx solid var(--accent-line);
  box-shadow: 0 12rpx 32rpx -12rpx rgba(21, 88, 199, 0.35);
}

.school-name {
  font-size: 35rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.college-name {
  font-size: 38rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.system-name {
  font-size: 25rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
}

.login-form {
  width: 100%;
  padding: 44rpx 36rpx;
  box-sizing: border-box;
}

.login-form .input-group {
  margin-bottom: 28rpx;
}

.login-form .input-label {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 14rpx;
  font-weight: 550;
}

.login-form .input-field {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-ctrl);
  box-sizing: border-box;
  background: var(--surface);
  color: var(--ink);
}

.ph {
  color: var(--ink-3);
}

.login-btn {
  width: 100% !important;
  margin-top: 36rpx;
  height: 92rpx !important;
  line-height: 92rpx !important;
  font-size: 34rpx !important;
  border-radius: var(--r-ctrl) !important;
}

.admin-entry {
  text-align: center;
  margin-top: 28rpx;
  padding: 16rpx;
}

.admin-entry text {
  font-size: 25rpx;
  color: var(--ink-3);
}

.footer {
  margin-top: 64rpx;
  text-align: center;
}

.footer text {
  font-size: 23rpx;
  color: var(--ink-3);
}

/* 密码修改弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(16, 24, 40, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 80%;
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-desc {
  font-size: 25rpx;
  color: var(--ink-3);
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-input-group {
  margin-bottom: 20rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-ctrl);
  box-sizing: border-box;
  background: var(--surface);
}

.modal-btns {
  display: flex;
  margin-top: 30rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--r-ctrl);
  text-align: center;
  border: none;
  padding: 0;
  transition: background-color var(--dur-fast, 150ms) ease, transform var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
}

.modal-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.modal-btn.cancel {
  background: var(--neutral-bg);
  color: var(--ink-2);
}

.modal-btn.confirm {
  background: var(--accent);
  color: #fff;
}

.pwd-strength {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  gap: 12rpx;
}

.pwd-str-bar {
  height: 8rpx;
  border-radius: 4rpx;
  transition: all 0.3s;
}

.pwd-str-text {
  font-size: 22rpx;
}

.str-weak { color: var(--danger); }
.str-medium { color: var(--warning); }
.str-strong { color: var(--success); }

.pwd-str-bar.str-weak { background: var(--danger); width: 80rpx; }
.pwd-str-bar.str-medium { background: var(--warning); width: 160rpx; }
.pwd-str-bar.str-strong { background: var(--success); width: 240rpx; }

.pwd-match {
  margin-top: 6rpx;
}

.match-ok {
  font-size: 22rpx;
  color: var(--success);
}

.match-no {
  font-size: 22rpx;
  color: var(--danger);
}
