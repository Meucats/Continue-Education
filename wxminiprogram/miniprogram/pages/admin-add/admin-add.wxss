.add-container {
  padding: 30rpx 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

.add-container .page-title {
  margin-bottom: 28rpx;
}

.form-card {
  padding: 36rpx 30rpx;
  margin: 0;
}

.required {
  color: var(--danger);
  margin-left: 5rpx;
}

.picker-field {
  border: 2rpx solid var(--line);
  border-radius: var(--r-ctrl);
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--ink);
  background-color: var(--surface);
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

.dates-preview {
  max-height: 300rpx;
  overflow-y: auto;
  background: var(--accent-soft);
  border-radius: var(--r-ctrl);
  padding: 16rpx;
  border: 1rpx solid var(--accent-line);
}

.date-preview-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: var(--surface);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid var(--line);
}

.date-preview-item:last-child {
  margin-bottom: 0;
}

.dp-date {
  font-size: 27rpx;
  color: var(--ink);
  font-weight: 550;
}

.dp-time {
  font-size: 25rpx;
  color: var(--accent);
}

.submit-btn {
  width: 100% !important;
  height: 92rpx !important;
  line-height: 92rpx !important;
  font-size: 34rpx !important;
  margin-top: 36rpx !important;
  border-radius: var(--r-ctrl) !important;
}

.cancel-btn {
  width: 100% !important;
  height: 92rpx !important;
  line-height: 92rpx !important;
  font-size: 34rpx !important;
  margin-top: 20rpx !important;
  border-radius: var(--r-ctrl) !important;
  background-color: var(--neutral-bg) !important;
  color: var(--ink-2) !important;
}
